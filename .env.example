# Base URL of the deployed edge functions (Supabase: https://<project>.supabase.co/functions/v1).
# Leave empty to run the app in offline demo mode with the built-in rule-based tutor.
EXPO_PUBLIC_AI_ENDPOINT=
# Supabase anon key (sent as Bearer token to the edge functions). Not a secret.
EXPO_PUBLIC_AI_ANON_KEY=
